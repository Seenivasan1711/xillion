# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.env
!.env.example

# Alembic
alembic/versions/*.pyc

# Data & secrets
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
*.pem
*.key

# Cached instrument masters — large (30MB+), refetched automatically on demand
# (see data_providers/dhanhq.py, xillion/core/instrument_cache.py)
data/*.csv
data/.encryption_key

# Warehouse backups (make backup-warehouse) -- gzipped snapshots, 200MB+,
# meant for Drive/offline storage, never git history. Found this gap
# 2026-09-21 while making one: no existing rule covered data/backups/ at
# all, so `git add -A` would have staged a 241MB blob.
data/backups/

# XAUUSD scalping research pipeline's downloaded M1 data + backup archives
# (research/xauusd_scalping/data/xauusd/, .../data/backups/) -- same
# "regenerable from a free source, meant for Drive not git history" spirit
# as data/backups/ above, found proactively 2026-09-22 before this grew
# into a real accidental-commit risk (a full 3-year M1 backfill is
# meaningfully large). The rest of research/xauusd_scalping/ (code,
# markdown deliverables) is real project work and stays tracked.
research/xauusd_scalping/data/xauusd/
research/xauusd_scalping/data/backups/

# run_backtests.py's raw dump -- regenerated by re-running the script,
# 03_results.md is the actual reviewed deliverable
research/xauusd_scalping/_backtest_results_raw.json
research/xauusd_scalping/_zero_cost_results.json
research/xauusd_scalping/_timeframe_experiment_raw.json

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Token cache (Zerodha access tokens)
*.token

# Per-branch git worktrees (see global CLAUDE.md worktree convention)
**/.claude/worktrees/
