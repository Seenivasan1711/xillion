# Where your xillion backend is reachable from this machine.
# Local dev: http://localhost:8001/api
# Deployed on Render: https://<your-app>.onrender.com/api
XILLION_API_BASE=http://localhost:8001/api

# Must match the broker connection name the backend registered --
# "MT5 Funding Pips" unless you changed it.
XILLION_MT5_CONNECTION_NAME=MT5 Funding Pips

# A real xillion login -- the bridge authenticates as this user, same as
# the web UI. Create a dedicated user for this if you'd rather not reuse
# your own admin login.
XILLION_MT5_BRIDGE_USERNAME=
XILLION_MT5_BRIDGE_PASSWORD=

# Only needed if that account has 2FA enabled. Prefer the TOTP_SECRET (the
# base32 seed from your authenticator app setup, NOT a 6-digit code) so the
# bridge can log back in on its own after a session expires -- a bare
# TOTP_CODE only works once, for the very first login.
XILLION_MT5_BRIDGE_TOTP_SECRET=
XILLION_MT5_BRIDGE_TOTP_CODE=

# How often (seconds) the bridge polls for new orders / reports prices.
XILLION_MT5_POLL_INTERVAL_SECONDS=2
